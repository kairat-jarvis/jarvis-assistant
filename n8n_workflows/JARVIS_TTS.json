{
  "name": "JARVIS TTS",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "jarvis-tts",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "jarvis-tts-webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [-800, 300],
      "webhookId": "jarvis-tts"
    },
    {
      "parameters": {
        "jsCode": "// Validate input\nconst body = $input.first().json.body || $input.first().json;\nconst text = body.text || '';\nconst voice = body.voice || 'nova';\nconst speed = body.speed || 1.0;\nconst model = body.model || 'tts-1';\n\nif (!text) {\n  throw new Error('Parameter \"text\" is required');\n}\n\nif (text.length > 4096) {\n  throw new Error('Text too long (max 4096 chars)');\n}\n\n// Valid OpenAI voices: alloy, echo, fable, onyx, nova, shimmer\nconst validVoices = ['alloy', 'echo', 'fable', 'onyx', 'nova', 'shimmer'];\nif (!validVoices.includes(voice)) {\n  throw new Error(`Invalid voice. Must be one of: ${validVoices.join(', ')}`);\n}\n\n// Generate filename\nconst timestamp = new Date().toISOString().replace(/[:.]/g, '-');\nconst filename = `jarvis-tts-${timestamp}.mp3`;\n\nreturn [{\n  json: {\n    text: text,\n    voice: voice,\n    speed: speed,\n    model: model,\n    filename: filename\n  }\n}];"
      },
      "id": "jarvis-tts-validate",
      "name": "Validate Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-560, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/audio/speech",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"{{ $json.model }}\",\n  \"voice\": \"{{ $json.voice }}\",\n  \"input\": {{ JSON.stringify($json.text) }},\n  \"speed\": {{ $json.speed }}\n}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      },
      "id": "jarvis-tts-openai",
      "name": "OpenAI TTS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-320, 300],
      "credentials": {
        "openAiApi": {
          "id": "K9JiW8NJnEvUzMrg",
          "name": "OpenAi account"
        }
      }
    },
    {
      "parameters": {
        "operation": "upload",
        "name": "={{ $('Validate Input').first().json.filename }}",
        "driveId": {
          "__rl": true,
          "mode": "list",
          "value": "My Drive"
        },
        "folderId": {
          "__rl": true,
          "mode": "name",
          "value": "JARVIS/audio"
        },
        "options": {}
      },
      "id": "jarvis-tts-drive",
      "name": "Save to Drive",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [-80, 300]
    },
    {
      "parameters": {
        "jsCode": "// Build response with public link\nconst file = $input.first().json;\nconst filename = $('Validate Input').first().json.filename;\n\nreturn [{\n  json: {\n    success: true,\n    filename: filename,\n    file_id: file.id,\n    web_view_link: file.webViewLink || `https://drive.google.com/file/d/${file.id}/view`,\n    web_content_link: file.webContentLink || null,\n    created_at: new Date().toISOString()\n  }\n}];"
      },
      "id": "jarvis-tts-response",
      "name": "Format Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [160, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}"
      },
      "id": "jarvis-tts-respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [400, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{ "node": "Validate Input", "type": "main", "index": 0 }]]
    },
    "Validate Input": {
      "main": [[{ "node": "OpenAI TTS", "type": "main", "index": 0 }]]
    },
    "OpenAI TTS": {
      "main": [[{ "node": "Save to Drive", "type": "main", "index": 0 }]]
    },
    "Save to Drive": {
      "main": [[{ "node": "Format Response", "type": "main", "index": 0 }]]
    },
    "Format Response": {
      "main": [[{ "node": "Respond", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "staticData": null,
  "tags": [{ "name": "JARVIS" }, { "name": "TTS" }]
}
