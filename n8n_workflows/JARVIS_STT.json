{
  "name": "JARVIS STT",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "jarvis-stt",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "jarvis-stt-webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [-900, 300],
      "webhookId": "jarvis-stt"
    },
    {
      "parameters": {
        "jsCode": "// Validate input\nconst body = $input.first().json.body || $input.first().json;\nconst audioUrl = body.audio_url || body.url || '';\nconst language = body.language || 'ru';\nconst prompt = body.prompt || '';\nconst responseFormat = body.response_format || 'verbose_json';\n\nif (!audioUrl) {\n  throw new Error('Parameter \"audio_url\" is required');\n}\n\n// Validate URL format\ntry {\n  new URL(audioUrl);\n} catch (e) {\n  throw new Error(`Invalid URL: ${audioUrl}`);\n}\n\nreturn [{\n  json: {\n    audio_url: audioUrl,\n    language: language,\n    prompt: prompt,\n    response_format: responseFormat\n  }\n}];"
      },
      "id": "jarvis-stt-validate",
      "name": "Validate Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-680, 300]
    },
    {
      "parameters": {
        "url": "={{ $json.audio_url }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      },
      "id": "jarvis-stt-download",
      "name": "Download Audio",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/audio/transcriptions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "file",
              "inputDataFieldName": "data"
            },
            {
              "name": "model",
              "value": "whisper-1"
            },
            {
              "name": "language",
              "value": "={{ $('Validate Input').first().json.language }}"
            },
            {
              "name": "prompt",
              "value": "={{ $('Validate Input').first().json.prompt }}"
            },
            {
              "name": "response_format",
              "value": "={{ $('Validate Input').first().json.response_format }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "jarvis-stt-whisper",
      "name": "Whisper STT",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-240, 300],
      "credentials": {
        "openAiApi": {
          "id": "REPLACE_WITH_OPENAI_CREDENTIALS_ID",
          "name": "OpenAi account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Format transcription response\nconst result = $input.first().json;\nconst input = $('Validate Input').first().json;\n\n// Whisper returns different structures based on response_format\n// verbose_json: { task, language, duration, text, segments: [...] }\n// json: { text }\n// text: plain text\n\nlet text = '';\nlet duration = null;\nlet language = input.language;\nlet segments = [];\n\nif (typeof result === 'string') {\n  text = result;\n} else if (result.text) {\n  text = result.text;\n  duration = result.duration;\n  language = result.language || language;\n  segments = result.segments || [];\n}\n\nreturn [{\n  json: {\n    success: true,\n    text: text.trim(),\n    language: language,\n    duration_seconds: duration,\n    segments_count: segments.length,\n    audio_url: input.audio_url,\n    transcribed_at: new Date().toISOString()\n  }\n}];"
      },
      "id": "jarvis-stt-format",
      "name": "Format Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-20, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}"
      },
      "id": "jarvis-stt-respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [200, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{ "node": "Validate Input", "type": "main", "index": 0 }]]
    },
    "Validate Input": {
      "main": [[{ "node": "Download Audio", "type": "main", "index": 0 }]]
    },
    "Download Audio": {
      "main": [[{ "node": "Whisper STT", "type": "main", "index": 0 }]]
    },
    "Whisper STT": {
      "main": [[{ "node": "Format Response", "type": "main", "index": 0 }]]
    },
    "Format Response": {
      "main": [[{ "node": "Respond", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "staticData": null,
  "tags": [{ "name": "JARVIS" }, { "name": "STT" }]
}
